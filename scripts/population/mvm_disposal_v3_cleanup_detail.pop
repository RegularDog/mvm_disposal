#base robot_giant.pop
#base robot_standard.pop
#base robot_disposal.pop

//==================================================//
//													//
//  MVM_DISPOSAL SPAWN POINTS AND NAV TAGS			//
//													//
//  SPAWNS											//
//													//
//	  spawnbot ->									//
//	    Standard mid spawn point.					//
//													//
//	  spawnbot_left	->								//
//		Spawns from the left side building.			//
//													//
//	  spawnbot_right ->								//
//	    Spawns from the right side cliff.			//
//	  												//
//	  spawnbot_lower ->								//
//		Spawn under the left side building,			//
//		ideal for boss spawns.						//
//													//
//	  spawnbot_invasion ->							//
//		Spawn from any spawn area (Main, Lower,		//
//		Left, Right.)								//
//													//
//	  spawnbot_mission_sniper ->					//
//		Spawns from the right OR left side,			//
//		gives snipers easy access to their			//
//		respective hint nodes.						//
//													//
//    spawnbot_mission_sentrybuster ->				//
//		Spawns using the far left or right flank	//
//		routes.										//
//													//
//    spawnbot_mission_spy ->						//
//		Same as mission_sentrybuster				//
//													//
//	  tankpath ->									//
//		Tank spawn point - automatically uses		//
//		entity logic to randomize using the 		//
//		right or left mid tank paths. The paths		//
//		do overlap, so leave a delay between		//
//		tank spawns.								//
//													//
//													//
//	TAGS											//
//													//
//	  flanker ->									//
//		allows using the upper left and right		//
//		side paths.									//
//													//
//==================================================//

WaveSchedule
{

	StartingCurrency 1400
	RespawnWaveTime 8
	CanBotsAttackWhileInSpawnRoom no
	
	Mission //Sentry Busters wave 1-4
	{ 
	
		Objective DestroySentries
		Where spawnbot_mission_sentrybuster
		BeginAtWave 8
		RunForThisManyWaves 4
		CooldownTime 30
		DesiredCount 1
		
		TFBot{ Template T_TFBot_SentryBuster }
	
	}
	
	Mission // Snipers - wave 3 and 4
	{
	
		Objective Sniper
		Where spawnbot_mission_sniper
		BeginAtWave 3
		RunForThisManyWaves 1
		InitialCooldown 20
		CooldownTime 40
		DesiredCount 2
		
		TFBot{ Template T_TFBot_Sniper }
	
	}
	
	Mission // Spies - wave 1
	{
	
		Objective Spy
		Where spawnbot_mission_spy
		BeginAtWave 1
		RunForThisManyWaves 1
		InitialCooldown 60
		CooldownTime 90
		DesiredCount 2
		
		TFBot{ Template T_TFBot_Spy }
	
	}
	
	Mission // Spies - wave 3
	{
	
		Objective Spy
		Where spawnbot_mission_spy
		BeginAtWave 3
		RunForThisManyWaves 1
		InitialCooldown 20
		CooldownTime 90
		DesiredCount 3
		
		TFBot{ Template T_TFBot_Spy }
	
	}
	
	Mission // Engineer - wave 2
	{
		Objective Engineer  

		InitialCooldown 30
		Where spawnbot
		BeginAtWave 2
		RunForThisManyWaves 1
		CooldownTime 60
		DesiredCount 1

		TFBot
		{
			Template T_TFBot_Engineer_Sentry_Teleporter
		}
	}	
	
