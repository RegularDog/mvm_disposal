YoFirstMissionin2026
{
    StartingCurrency 400 // 400
    CanBotsAttackWhileInSpawnRoom No
    RespawnWaveTime 3
    FixedRespawnWaveTime Yes
    AddSentryBusterWhenDamageDealtExceeds 3000
    AddSentryBusterWhenKillCountExceeds 15
    //Advanced 1

    //
    // Starting Currency: 400
    //
    // +----------+----------+----------+
    // | Wave     | Currency | A+       |
    // +----------+----------+----------+
    // | Wave 1   | 400      | 500      |
    // | Wave 2   | 550      | 650      |
    // | Wave 3   | 300      | 400      |
    // | Wave 4   | 500      | 600      |
    // | Wave 5   | 400      | 500      |
    // | Wave 6   | 300      | 400      |
    // | Wave 7   | 550      | 650      |
    // | Wave 8   | 200      | 300      |
    // +----------+----------+----------+
    // | Total    | 3200     | 4000     |
    // +----------+----------+----------+
    //    

