            {
                Template T_TFBot_Sentry_Buster_firering
            }
            TFBot
            {
                Template T_TFBot_Sentry_Buster_healthpack
            }
            TFBot
            {
                Template T_TFBot_Sentry_Buster_jumping_para
            }
