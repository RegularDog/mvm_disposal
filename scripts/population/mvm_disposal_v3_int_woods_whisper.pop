    Mission // RandomSentryBusters
    {
        Where spawnbot
        Objective DestroySentries
        BeginAtWave 1
        RunForThisManyWaves 8
        DesiredCount 1
    
        InitialCooldown 0
        CooldownTime 30

        RandomChoice
        {
            Squad
            {
                FormationSize 100
                TFBot
                {
                    Template T_TFBot_Sentry_Buster_squadleader
                }
