    Mission
    {
        Where spawnbot_invasion
        Objective DestroySentries
        BeginAtWave 1
        RunForThisManyWaves 8
        DesiredCount 1
    
        InitialCooldown 0
        CooldownTime 30

        RandomChoice
        {
            TFBot
            {
